# LabGuard Environment Configuration
# ====================================
# Copy this file to .env and adjust values for your environment.
# .env is listed in .gitignore and will never be committed.
#
# Linux/macOS — load before running server:
#   export $(cat .env | grep -v '#' | xargs)
#
# Windows (PowerShell):
#   Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }

# --------------------------------------------------
# Database
# --------------------------------------------------
LABGUARD_DB_PATH=database/labguard.db

# --------------------------------------------------
# Flask Server
# --------------------------------------------------
LABGUARD_HOST=0.0.0.0
LABGUARD_PORT=5000
LABGUARD_DEBUG=true

# --------------------------------------------------
# Offline Detection
# How many seconds without a heartbeat before a computer
# is considered offline. Default: 120 (2 minutes).
# --------------------------------------------------
LABGUARD_HEARTBEAT_TIMEOUT=120

# --------------------------------------------------
# Agent Settings
# Point LABGUARD_SERVER_URL at the LAN IP of your server machine.
# Example for a homelab server at 192.168.1.100:
# --------------------------------------------------
LABGUARD_SERVER_URL=http://192.168.1.100:5000
LABGUARD_HEARTBEAT_INTERVAL=30

