# LabGuard Frontend Environment Configuration
# ===========================================
# Copy this file to .env and adjust values for your environment.
# Vite loads VITE_* variables when the frontend starts or builds.
# Restart the Vite dev server after changing this file.

# --------------------------------------------------
# Backend REST API
# --------------------------------------------------
# Include the /api path. Use 127.0.0.1 when the browser and backend
# are running on the same machine.
VITE_API_URL=http://127.0.0.1:5000/api

# --------------------------------------------------
# Backend WebSocket / Socket.IO server
# --------------------------------------------------
# Use the backend base URL without the /api path.
VITE_WS_URL=http://127.0.0.1:5000

# --------------------------------------------------
# Polling fallback
# --------------------------------------------------
# Milliseconds between REST refreshes when WebSocket updates are
# unavailable. 12000 = 12 seconds.
VITE_POLLING_INTERVAL=12000

# --------------------------------------------------
# LAN configuration
# --------------------------------------------------
# When opening the dashboard from another computer, replace
# 127.0.0.1 in both URLs with the server machine's reachable LAN IP.
# Example:
# VITE_API_URL=http://192.168.1.100:5000/api
# VITE_WS_URL=http://192.168.1.100:5000
#
# Do not use 0.0.0.0 here. It is a server bind address, not a
# browser destination. The backend may still use LABGUARD_HOST=0.0.0.0.
